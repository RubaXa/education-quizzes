rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A link's random document ID is its access key. Collection enumeration is
    // never allowed from the browser. Administrative writes use IAM locally.
    match /assignments/{linkToken} {
      allow get: if true;
      allow list, create, delete: if false;

      allow update: if resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answers', 'status', 'startedAt', 'updatedAt', 'submittedAt'])
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 100
        && request.resource.data.updatedAt == request.time
        && request.resource.data.startedAt is timestamp
        && (resource.data.startedAt == null
          ? request.resource.data.startedAt == request.time
          : request.resource.data.startedAt == resource.data.startedAt)
        && (
          (request.resource.data.status == 'open'
            && request.resource.data.submittedAt == null)
          ||
          (request.resource.data.status == 'submitted'
            && request.resource.data.submittedAt == request.time)
        );
    }

    match /answerKeys/{linkToken} {
      allow get: if exists(/databases/$(database)/documents/assignments/$(linkToken))
        && get(/databases/$(database)/documents/assignments/$(linkToken)).data.status == 'submitted';
      allow list, write: if false;
    }

    match /reviews/{linkToken} {
      allow get: if exists(/databases/$(database)/documents/assignments/$(linkToken))
        && get(/databases/$(database)/documents/assignments/$(linkToken)).data.status == 'submitted';
      allow list, write: if false;
    }

    match /previews/{previewToken} {
      allow get: if true;
      allow list, write: if false;
    }

    match /dashboard/{dashboardToken}/assignments/{assignmentId} {
      allow get, list: if true;
      allow write: if false;
    }

    match /dashboard/{dashboardToken}/seen/{assignmentId} {
      allow get, list: if true;
      allow create, update: if exists(/databases/$(database)/documents/dashboard/$(dashboardToken))
        && get(/databases/$(database)/documents/dashboard/$(dashboardToken)).data.kind == 'parent'
        && exists(/databases/$(database)/documents/dashboard/$(dashboardToken)/assignments/$(assignmentId))
        && request.resource.data.keys().hasOnly(['seenAt'])
        && request.resource.data.seenAt == request.time;
      allow delete: if false;
    }

    match /dayPages/{linkToken} {
      allow get: if true;
      allow list, write: if false;
    }

    match /dayProgress/{studentToken}/items/{taskId} {
      allow get, list: if exists(/databases/$(database)/documents/dayPages/$(studentToken))
        && get(/databases/$(database)/documents/dayPages/$(studentToken)).data.kind == 'student';
      allow write: if false;
    }

    match /dayUploads/{studentToken}/files/{uploadId} {
      allow get, list: if exists(/databases/$(database)/documents/dayPages/$(studentToken))
        && get(/databases/$(database)/documents/dayPages/$(studentToken)).data.kind == 'student';
      allow create: if exists(/databases/$(database)/documents/dayPages/$(studentToken))
        && get(/databases/$(database)/documents/dayPages/$(studentToken)).data.kind == 'student'
        && request.resource.data.keys().hasOnly(['taskId', 'dataUrl', 'originalName', 'status', 'createdAt'])
        && request.resource.data.taskId is string
        && request.resource.data.taskId in get(/databases/$(database)/documents/dayPages/$(studentToken)).data.taskIds
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 750000
        && request.resource.data.dataUrl.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+')
        && request.resource.data.originalName is string
        && request.resource.data.originalName.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
