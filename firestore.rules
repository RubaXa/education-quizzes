rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Version 2: a long secret link identifies a person; Firebase anonymous Auth
    // identifies the device. Neither role nor child access is client-writable.
    function validLink(secret) {
      return secret is string
        && secret.matches('^[A-Za-z0-9_-]{43}$')
        && exists(/databases/$(database)/documents/accessLinks/$(secret))
        && get(/databases/$(database)/documents/accessLinks/$(secret)).data.active == true;
    }
    function linkPath() {
      let secret = get(/databases/$(database)/documents/deviceSessions/$(request.auth.uid)).data.linkToken;
      return /databases/$(database)/documents/accessLinks/$(secret);
    }
    function activeSession() {
      return request.auth != null
        && exists(/databases/$(database)/documents/deviceSessions/$(request.auth.uid))
        && get(linkPath()).data.active == true;
    }
    function currentPersonId() {
      return get(linkPath()).data.personId;
    }
    function memberPath(familyId) {
      let person = currentPersonId();
      return /databases/$(database)/documents/families/$(familyId)/members/$(person);
    }
    function activeMember(familyId) {
      return activeSession()
        && exists(memberPath(familyId))
        && get(memberPath(familyId)).data.active == true;
    }
    function parentMember(familyId) {
      return activeMember(familyId)
        && get(memberPath(familyId)).data.role == 'parent';
    }
    function childMember(familyId, childId) {
      return activeMember(familyId)
        && get(memberPath(familyId)).data.childIds.hasAny([childId]);
    }
    function quizStudent(familyId, childId) {
      return childMember(familyId, childId)
        && get(memberPath(familyId)).data.role == 'student';
    }
    function dayUploadOwner(studentToken) {
      return activeSession()
        && exists(/databases/$(database)/documents/dayOwners/$(studentToken))
        && childMember(
          get(/databases/$(database)/documents/dayOwners/$(studentToken)).data.familyId,
          get(/databases/$(database)/documents/dayOwners/$(studentToken)).data.childId);
    }
    // A stage choice needs one read per source document. Repeated nested access
    // checks can exceed Firestore's per-write document-access limit.
    // @see docs/modules/school-diary/day-page.md#review-stage-switch
    function validReviewedStageChoice(studentToken, eventId, data) {
      let session = get(/databases/$(database)/documents/deviceSessions/$(request.auth.uid)).data;
      let link = get(/databases/$(database)/documents/accessLinks/$(session.linkToken)).data;
      let owner = get(/databases/$(database)/documents/dayOwners/$(studentToken)).data;
      let member = get(/databases/$(database)/documents/families/$(owner.familyId)/members/$(link.personId)).data;
      let page = get(/databases/$(database)/documents/dayPages/$(studentToken)).data;
      let guide = get(/databases/$(database)/documents/dayTaskGuides/$(studentToken)/items/$(data.taskId)).data.guide;
      let review = get(/databases/$(database)/documents/dayProgress/$(studentToken)/items/$(data.taskId)).data;
      return request.auth != null
        && link.active == true
        && member.active == true
        && member.role == 'parent'
        && owner.childId in member.childIds
        && eventId.matches('^[a-f0-9-]{36}$')
        && data.taskId is string
        && data.taskId in page.taskIds
        && data.action in ['stage-required', 'stage-optional']
        && data.actorPersonId == link.personId
        && data.decidedAt == request.time
        && data.keys().hasOnly(['taskId', 'action', 'stageId', 'stageIndex', 'guideRevision', 'reviewCheckedAt', 'actorPersonId', 'decidedAt'])
        && data.keys().hasAll(['taskId', 'action', 'stageId', 'stageIndex', 'guideRevision', 'reviewCheckedAt', 'actorPersonId', 'decidedAt'])
        && data.stageId is string
        && data.stageIndex is int
        && data.stageIndex >= 0
        && data.guideRevision is int
        && guide.presentation == 'learning-route'
        && data.guideRevision == guide.revision
        && data.stageIndex < guide.stages.size()
        && data.stageId == guide.stages[data.stageIndex].id
        && review.checkableStageIds is list
        && data.stageId in review.checkableStageIds
        && data.reviewCheckedAt == review.checkedAt;
    }

    // A random invite code is the only public route to the one-time encrypted handoff.
    // The operator alone writes invitations and reads them in bulk through Admin SDK.
    // @see docs/modules/school-diary/README.md#family-onboarding-research
    match /connectionInvites/{inviteCode} {
      allow get: if request.auth != null && inviteCode.matches('^[A-Za-z0-9_-]{43}$');
      allow list, write: if false;
      match /handoff/{handoffId} {
        allow get: if request.auth != null && handoffId == 'current'
          && inviteCode.matches('^[A-Za-z0-9_-]{43}$');
        allow list, update, delete: if false;
        allow create: if request.auth != null && handoffId == 'current'
          && inviteCode.matches('^[A-Za-z0-9_-]{43}$')
          && exists(/databases/$(database)/documents/connectionInvites/$(inviteCode))
          && get(/databases/$(database)/documents/connectionInvites/$(inviteCode)).data.status == 'open'
          && get(/databases/$(database)/documents/connectionInvites/$(inviteCode)).data.expiresAt > request.time
          && request.resource.data.keys().hasOnly(['version', 'ephemeralKey', 'iv', 'ciphertext', 'tag', 'submittedAt'])
          && request.resource.data.keys().hasAll(['version', 'ephemeralKey', 'iv', 'ciphertext', 'tag', 'submittedAt'])
          && request.resource.data.version == 1
          && request.resource.data.ephemeralKey is string
          && request.resource.data.ephemeralKey.matches('^[A-Za-z0-9_-]{50,100}$')
          && request.resource.data.iv is string
          && request.resource.data.iv.matches('^[A-Za-z0-9_-]{16}$')
          && request.resource.data.tag is string
          && request.resource.data.tag.matches('^[A-Za-z0-9_-]{22}$')
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() > 0
          && request.resource.data.ciphertext.size() <= 110000
          && request.resource.data.submittedAt == request.time;
      }
    }

    match /sourceIdentities/{identityId} { allow read, write: if false; }
    match /sourceAccounts/{accountId} { allow read, write: if false; }
    // @see docs/modules/synchronization/global-sync.md#operator-queue
    match /operatorSyncJobs/{jobId} { allow read, write: if false; }

    // Temporary, operator-enabled role measurements. No client reads or lesson data.
    // @see docs/modules/families/access-and-state.md#access-diagnostics
    match /clientRoleDiagnostics/{authUid} {
      allow read, delete: if false;
      allow create, update: if request.auth != null && request.auth.uid == authUid
        && activeSession()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'probeVersion', 'personId', 'familyId', 'childId', 'memberRole', 'profileRole', 'renderedRole', 'hasGuide', 'surface', 'sampledAt', 'expiresAt'])
        && request.resource.data.keys().hasAll(['schemaVersion', 'probeVersion', 'personId', 'familyId', 'childId', 'memberRole', 'profileRole', 'renderedRole', 'hasGuide', 'surface', 'sampledAt', 'expiresAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.probeVersion == 'role-projection-v1'
        && request.resource.data.personId == currentPersonId()
        && request.resource.data.familyId is string && request.resource.data.childId is string
        && childMember(request.resource.data.familyId, request.resource.data.childId)
        && request.resource.data.memberRole == get(memberPath(request.resource.data.familyId)).data.role
        && request.resource.data.profileRole in ['parent', 'student']
        && request.resource.data.renderedRole in ['parent', 'student']
        && request.resource.data.hasGuide is bool
        && request.resource.data.surface in ['day', 'day-parent', 'days', 'days-parent', 'home']
        && request.resource.data.sampledAt == request.time
        && request.resource.data.expiresAt == get(memberPath(request.resource.data.familyId)).data.accessDiagnosticsUntil
        && request.time < request.resource.data.expiresAt;
    }

    match /accessLinks/{secret} {
      allow get: if activeSession()
        && get(/databases/$(database)/documents/deviceSessions/$(request.auth.uid)).data.linkToken == secret;
      allow list, write: if false;
    }
    match /deviceSessions/{authUid} {
      allow get: if request.auth != null && request.auth.uid == authUid;
      allow list, delete: if false;
      allow create: if request.auth != null && request.auth.uid == authUid
        && request.resource.data.keys().hasOnly(['linkToken', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['linkToken', 'createdAt', 'updatedAt'])
        && validLink(request.resource.data.linkToken)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null && request.auth.uid == authUid
        && request.resource.data.keys().hasOnly(['linkToken', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['linkToken', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validLink(request.resource.data.linkToken);
    }

    match /users/{personId} {
      allow get: if activeSession() && currentPersonId() == personId;
      allow list, write: if false;

      // The browser requests an invite; only the local operator mints the
      // receiver key pair and publishes a usable link. No MESH secret enters UI.
      // @see docs/modules/families/README.md#invitations
      match /inviteRequests/{requestId} {
        allow get, list: if activeSession() && currentPersonId() == personId;
        allow create: if activeSession() && currentPersonId() == personId
          && request.resource.data.keys().hasOnly(['familyId', 'mode', 'delegateQuota', 'status', 'createdAt'])
          && request.resource.data.keys().hasAll(['familyId', 'mode', 'delegateQuota', 'status', 'createdAt'])
          && parentMember(request.resource.data.familyId)
          && request.resource.data.mode in ['same-family', 'new-family']
          && request.resource.data.delegateQuota is int
          && request.resource.data.delegateQuota >= 0
          && request.resource.data.delegateQuota <= 1000
          && request.resource.data.status == 'requested'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /invites/{inviteCode} {
        allow get, list: if activeSession() && currentPersonId() == personId;
        allow write: if false;
      }
      match /inviteRevocations/{requestId} {
        allow get, list: if activeSession() && currentPersonId() == personId;
        allow create: if activeSession() && currentPersonId() == personId
          && request.resource.data.keys().hasOnly(['inviteCode', 'status', 'createdAt'])
          && request.resource.data.keys().hasAll(['inviteCode', 'status', 'createdAt'])
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.matches('^[A-Za-z0-9_-]{43}$')
          && request.resource.data.status == 'requested'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /families/{familyId} {
        allow get, list: if activeSession() && currentPersonId() == personId;
        allow write: if false;
        match /shortcuts/{childId} {
          allow get, list: if activeSession() && currentPersonId() == personId
            && childMember(familyId, childId);
          allow write: if false;
        }
      }
      match /inbox/{notificationId} {
        allow get, list: if activeSession() && currentPersonId() == personId;
        // A parent's decision and the child's notice are committed together.
        // The client cannot invent review results or arbitrary announcement text.
        // @see docs/modules/notifications/inbox.md#notification-producers
        allow create: if activeSession()
          && request.resource.data.keys().hasOnly([
            'familyId', 'childId', 'type', 'entityId', 'taskId', 'studentToken',
            'eventId', 'date', 'sourceRevision', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'familyId', 'childId', 'type', 'entityId', 'taskId', 'studentToken',
            'eventId', 'date', 'sourceRevision', 'createdAt'
          ])
          && parentMember(request.resource.data.familyId)
          && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId)/members/$(personId))
          && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)/members/$(personId)).data.active == true
          && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)/members/$(personId)).data.role == 'student'
          && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)/members/$(personId)).data.childIds.hasAny([request.resource.data.childId])
          && request.resource.data.type in ['parent_accepted', 'parent_reopened', 'parent_requirement_mandatory', 'parent_requirement_optional', 'parent_guidance']
          && request.resource.data.entityId == request.resource.data.taskId
          && request.resource.data.sourceRevision == 1
          && request.resource.data.createdAt == request.time
          && notificationId == request.resource.data.eventId
          && request.resource.data.studentToken is string
          && exists(/databases/$(database)/documents/dayOwners/$(request.resource.data.studentToken))
          && get(/databases/$(database)/documents/dayOwners/$(request.resource.data.studentToken)).data.familyId == request.resource.data.familyId
          && get(/databases/$(database)/documents/dayOwners/$(request.resource.data.studentToken)).data.childId == request.resource.data.childId
          && get(/databases/$(database)/documents/dayOwners/$(request.resource.data.studentToken)).data.targetDate == request.resource.data.date
          && ((request.resource.data.type == 'parent_guidance'
              && existsAfter(/databases/$(database)/documents/dayGuidance/$(request.resource.data.studentToken)/items/$(request.resource.data.eventId))
              && getAfter(/databases/$(database)/documents/dayGuidance/$(request.resource.data.studentToken)/items/$(request.resource.data.eventId)).data.actorPersonId == currentPersonId()
              && getAfter(/databases/$(database)/documents/dayGuidance/$(request.resource.data.studentToken)/items/$(request.resource.data.eventId)).data.taskId == request.resource.data.taskId)
            || (request.resource.data.type != 'parent_guidance'
              && existsAfter(/databases/$(database)/documents/dayParentDecisions/$(request.resource.data.studentToken)/events/$(request.resource.data.eventId))
              && getAfter(/databases/$(database)/documents/dayParentDecisions/$(request.resource.data.studentToken)/events/$(request.resource.data.eventId)).data.actorPersonId == currentPersonId()
              && getAfter(/databases/$(database)/documents/dayParentDecisions/$(request.resource.data.studentToken)/events/$(request.resource.data.eventId)).data.taskId == request.resource.data.taskId
              && ((request.resource.data.type == 'parent_accepted'
              && getAfter(/databases/$(database)/documents/dayParentDecisions/$(request.resource.data.studentToken)/events/$(request.resource.data.eventId)).data.action == 'accept')
            || (request.resource.data.type == 'parent_reopened'
              && getAfter(/databases/$(database)/documents/dayParentDecisions/$(request.resource.data.studentToken)/events/$(request.resource.data.eventId)).data.action == 'reopen')
            || (request.resource.data.type == 'parent_requirement_mandatory'
              && getAfter(/databases/$(database)/documents/dayParentDecisions/$(request.resource.data.studentToken)/events/$(request.resource.data.eventId)).data.action == 'require')
            || (request.resource.data.type == 'parent_requirement_optional'
              && getAfter(/databases/$(database)/documents/dayParentDecisions/$(request.resource.data.studentToken)/events/$(request.resource.data.eventId)).data.action == 'optional'))));
        allow delete: if false;
        allow update: if activeSession() && currentPersonId() == personId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
      }
      match /views/{viewKey} {
        allow get, list: if activeSession() && currentPersonId() == personId;
        allow create, update: if activeSession() && currentPersonId() == personId
          && request.resource.data.keys().hasOnly(['sourceRevision', 'seenAt'])
          && request.resource.data.keys().hasAll(['sourceRevision', 'seenAt'])
          && request.resource.data.sourceRevision is int
          && request.resource.data.sourceRevision >= 0
          && request.resource.data.seenAt == request.time
          && (resource == null || request.resource.data.sourceRevision >= resource.data.sourceRevision);
        allow delete: if false;
      }
    }

    match /families/{familyId} {
      allow read, write: if false;

      match /invites/{inviteCode} {
        allow get, list: if parentMember(familyId)
          && get(memberPath(familyId)).data.inviteUnlimited == true;
        allow write: if false;
      }

      match /members/{memberId} {
        allow get: if activeMember(familyId)
          && currentPersonId() == memberId;
        allow list: if parentMember(familyId);
        allow write: if false;
      }
      match /ui/{viewId} {
        allow get, list: if activeMember(familyId)
          && ((resource.data.audience == 'parent' && parentMember(familyId))
            || (resource.data.audience == 'student'
              && (viewId == 'student-home' || viewId == 'student-day')));
        allow write: if false;
      }
      match /children/{childId} {
        allow get: if childMember(familyId, childId);
        allow list: if false;
        allow write: if false;

        // @see docs/modules/synchronization/global-sync.md#status
        match /syncStatus/{statusId} {
          allow get: if statusId == 'current' && childMember(familyId, childId);
          allow list, write: if false;
        }

        match /accessGrants/{grantId} {
          allow get, list: if parentMember(familyId) && childMember(familyId, childId);
          allow write: if false;
        }
        match /accessRequests/{requestId} {
          allow get, list: if parentMember(familyId) && childMember(familyId, childId);
          allow create: if parentMember(familyId) && childMember(familyId, childId)
            && request.resource.data.keys().hasOnly(['action', 'grantId', 'actorPersonId', 'status', 'createdAt'])
            && request.resource.data.keys().hasAll(['action', 'grantId', 'actorPersonId', 'status', 'createdAt'])
            && request.resource.data.action in ['rotate', 'revoke']
            && request.resource.data.grantId is string
            && (request.resource.data.action == 'rotate' && request.resource.data.grantId == ''
              || request.resource.data.action == 'revoke' && request.resource.data.grantId.matches('^[a-f0-9]{64}$'))
            && request.resource.data.actorPersonId == currentPersonId()
            && request.resource.data.status == 'requested'
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }

        match /books/{bookId} {
          allow get, list: if parentMember(familyId) && childMember(familyId, childId);
          allow write: if false;
        }
        match /bookPages/{pageRef} {
          allow get: if childMember(familyId, childId);
          allow list: if parentMember(familyId) && childMember(familyId, childId);
          allow write: if false;
        }
        // @see docs/modules/materials/family-library.md#firestore-model
        match /bookUploads/{uploadId} {
          allow get, list: if parentMember(familyId) && childMember(familyId, childId);
          allow create: if parentMember(familyId) && childMember(familyId, childId)
            && request.resource.data.keys().hasOnly([
              'subjectKey', 'originalName', 'contentType', 'size',
              'sha256', 'deviceUid', 'status', 'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'subjectKey', 'originalName', 'contentType', 'size',
              'sha256', 'deviceUid', 'status', 'createdAt'
            ])
            && request.resource.data.deviceUid == request.auth.uid
            && request.resource.data.status == 'requested'
            && request.resource.data.subjectKey is string
            && request.resource.data.subjectKey.size() > 0
            && request.resource.data.subjectKey.size() <= 100
            && request.resource.data.originalName is string
            && request.resource.data.originalName.size() > 0
            && request.resource.data.originalName.size() <= 160
            && request.resource.data.contentType == 'application/pdf'
            && request.resource.data.size is int
            && request.resource.data.size > 0
            && request.resource.data.size <= 100000000
            && request.resource.data.sha256 is string
            && request.resource.data.sha256.matches('^[a-f0-9]{64}$')
            && request.resource.data.createdAt == request.time;
          allow update: if parentMember(familyId) && childMember(familyId, childId)
            && resource.data.deviceUid == request.auth.uid
            && resource.data.status == 'awaiting-upload'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'uploaded';
          allow delete: if false;
        }
        match /bookRequirements/{subjectId} {
          allow get, list: if parentMember(familyId) && childMember(familyId, childId);
          allow create, update: if parentMember(familyId) && childMember(familyId, childId)
            && request.resource.data.keys().hasOnly(['subjectKey', 'policy', 'updatedAt', 'actorPersonId'])
            && request.resource.data.keys().hasAll(['subjectKey', 'policy', 'updatedAt', 'actorPersonId'])
            && request.resource.data.subjectKey is string
            && request.resource.data.subjectKey.size() > 0
            && request.resource.data.subjectKey.size() <= 100
            && request.resource.data.policy in ['required', 'no-book']
            && request.resource.data.actorPersonId == currentPersonId()
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }

        match /days/{dayId} {
          allow get, list: if childMember(familyId, childId);
          allow write: if false;
        }
        match /tasks/{taskId} {
          allow get, list: if childMember(familyId, childId);
          allow write: if false;
        }
        match /grades/{gradeId} {
          allow get, list: if childMember(familyId, childId);
          allow write: if false;
        }
        match /submissions/{submissionId} {
          allow get, list: if childMember(familyId, childId);
          // The Yandex Disk upload flow needs a server-issued upload endpoint.
          // Until it exists, do not accept client writes or image bytes here.
          allow write: if false;
        }
      }
      match /activity/{eventId} {
        allow get, list: if childMember(familyId, resource.data.childId)
          && (parentMember(familyId) || resource.data.actorPersonId == currentPersonId());
        allow create: if activeMember(familyId)
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'actorPersonId', 'deviceUid', 'childId', 'type', 'viewId',
            'sectionId', 'entityId', 'sessionId', 'occurredAt'
          ])
          && request.resource.data.keys().hasAll([
            'schemaVersion', 'actorPersonId', 'deviceUid', 'childId', 'type', 'viewId',
            'sectionId', 'entityId', 'sessionId', 'occurredAt'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.actorPersonId == currentPersonId()
          && request.resource.data.deviceUid == request.auth.uid
          && childMember(familyId, request.resource.data.childId)
          && request.resource.data.type in [
            'page_opened', 'section_opened', 'day_opened', 'task_opened',
            'test_started', 'test_submitted', 'submission_uploaded', 'notification_opened'
          ]
          && request.resource.data.viewId in [
            'student-home', 'parent-home', 'student-day', 'parent-day'
          ]
          && (request.resource.data.viewId in ['student-home', 'student-day']
            || parentMember(familyId))
          && request.resource.data.sectionId is string
          && request.resource.data.sectionId.size() <= 80
          && request.resource.data.entityId is string
          && request.resource.data.entityId.size() <= 120
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() <= 80
          && request.resource.data.occurredAt == request.time;
        allow update, delete: if false;
      }
    }

    // A link's random document ID is its access key. Collection enumeration is
    // never allowed from the browser. Administrative writes use IAM locally.
    match /assignments/{linkToken} {
      allow get: if true;
      allow list, create, delete: if false;

      allow update: if resource.data.status == 'open'
        && resource.data.familyId is string
        && resource.data.childId is string
        && quizStudent(resource.data.familyId, resource.data.childId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answers', 'status', 'startedAt', 'updatedAt', 'submittedAt'])
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 100
        && request.resource.data.updatedAt == request.time
        && request.resource.data.startedAt is timestamp
        && (resource.data.startedAt == null
          ? request.resource.data.startedAt == request.time
          : request.resource.data.startedAt == resource.data.startedAt)
        && (
          (request.resource.data.status == 'open'
            && request.resource.data.submittedAt == null)
          ||
          (request.resource.data.status == 'submitted'
            && request.resource.data.submittedAt == request.time)
        );

      // A parent may request one linked practice cycle after a submitted test.
      // The operator publishes questions; the browser cannot change a result.
      // @see docs/modules/assessments/quizzes.md#followup-request
      allow update: if resource.data.status == 'submitted'
        && resource.data.familyId is string
        && resource.data.childId is string
        && parentMember(resource.data.familyId)
        && childMember(resource.data.familyId, resource.data.childId)
        && !('followupRequestedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followupRequestedAt', 'followupRequestedBy'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['followupRequestedAt', 'followupRequestedBy'])
        && request.resource.data.followupRequestedAt == request.time
        && request.resource.data.followupRequestedBy == currentPersonId();

      // Only a parent may change whether a root self-check counts in the
      // family plan. Answers, scoring and the teacher task are untouched.
      // @see docs/modules/assessments/quizzes.md#optional-quiz
      allow update: if resource.data.familyId is string
        && resource.data.childId is string
        && parentMember(resource.data.familyId)
        && childMember(resource.data.familyId, resource.data.childId)
        && (!('linkedToTestId' in resource.data) || resource.data.linkedToTestId == null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyOptional', 'familyChoiceAt', 'familyChoiceBy'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['familyOptional', 'familyChoiceAt'])
        && request.resource.data.familyOptional is bool
        && (('familyOptional' in resource.data && request.resource.data.familyOptional != resource.data.familyOptional)
          || (!('familyOptional' in resource.data) && request.resource.data.familyOptional == true))
        && request.resource.data.familyChoiceAt == request.time
        && request.resource.data.familyChoiceBy == currentPersonId();
    }

    match /answerKeys/{linkToken} {
      allow get: if exists(/databases/$(database)/documents/assignments/$(linkToken))
        && get(/databases/$(database)/documents/assignments/$(linkToken)).data.status == 'submitted';
      allow list, write: if false;
    }

    match /reviews/{linkToken} {
      allow get: if exists(/databases/$(database)/documents/assignments/$(linkToken))
        && get(/databases/$(database)/documents/assignments/$(linkToken)).data.status == 'submitted';
      allow list, write: if false;
    }

    match /previews/{previewToken} {
      allow get: if true;
      allow list, write: if false;
    }

    match /dashboard/{dashboardToken}/assignments/{assignmentId} {
      allow get, list: if true;
      allow write: if false;
    }

    match /dashboard/{dashboardToken}/seen/{assignmentId} {
      allow get, list: if true;
      allow create, update: if exists(/databases/$(database)/documents/dashboard/$(dashboardToken))
        && get(/databases/$(database)/documents/dashboard/$(dashboardToken)).data.kind == 'parent'
        && exists(/databases/$(database)/documents/dashboard/$(dashboardToken)/assignments/$(assignmentId))
        && request.resource.data.keys().hasOnly(['seenAt'])
        && request.resource.data.seenAt == request.time;
      allow delete: if false;
    }

    match /dayPages/{linkToken} {
      allow get: if true;
      allow list, write: if false;
    }

    match /dayOwners/{studentToken} {
      allow get: if dayUploadOwner(studentToken);
      allow list, write: if false;
    }

    // The shared catalog is operator-only. Pages assigned to a child are
    // projected to families/.../children/.../bookPages.
    match /materialBooks/{bookId} {
      allow read, write: if false;
      match /pages/{pdfPage} {
        allow read, write: if false;
      }
    }

    match /dayDashboards/{linkToken} {
      allow get: if resource.data.familyId is string
        && resource.data.childId is string
        && childMember(resource.data.familyId, resource.data.childId)
        && ((resource.data.kind == 'parent' && parentMember(resource.data.familyId))
          || (resource.data.kind == 'student'
            && get(memberPath(resource.data.familyId)).data.role == 'student'));
      allow list, write: if false;
    }

    match /dayProgress/{studentToken}/items/{taskId} {
      allow get, list: if dayUploadOwner(studentToken);
      allow write: if false;
    }

    // Full reasoning and history are stored apart from the learner projection.
    // @see docs/modules/reviews/adaptive-problem-card.md#показ-ученику
    match /dayReviewPrivate/{studentToken}/items/{taskId} {
      allow get, list: if dayUploadOwner(studentToken)
        && parentMember(get(/databases/$(database)/documents/dayOwners/$(studentToken)).data.familyId);
      allow write: if false;
    }

    // Prepared solution/structure before any attempt. A public dayPages token never grants access.
    // @see docs/modules/reviews/subject-aware-guidance.md#parent-card
    match /dayTaskGuides/{studentToken}/items/{taskId} {
      allow get, list: if dayUploadOwner(studentToken)
        && parentMember(get(/databases/$(database)/documents/dayOwners/$(studentToken)).data.familyId);
      allow write: if false;
    }

    // The parent can release exactly one prepared hint or solution stage.
    // The learner sees only this selected text, never the complete guide.
    // @see docs/modules/reviews/subject-aware-guidance.md#math-route
    match /dayGuidance/{studentToken}/items/{eventId} {
      allow get, list: if dayUploadOwner(studentToken);
      allow create: if dayUploadOwner(studentToken)
        && parentMember(get(/databases/$(database)/documents/dayOwners/$(studentToken)).data.familyId)
        && eventId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.keys().hasOnly(['taskId', 'stageId', 'stageIndex', 'level', 'text', 'guideRevision', 'actorPersonId', 'createdAt'])
        && request.resource.data.keys().hasAll(['taskId', 'stageId', 'stageIndex', 'level', 'text', 'guideRevision', 'actorPersonId', 'createdAt'])
        && request.resource.data.taskId is string
        && request.resource.data.taskId in get(/databases/$(database)/documents/dayPages/$(studentToken)).data.taskIds
        && request.resource.data.stageId is string
        && request.resource.data.stageIndex is int
        && request.resource.data.stageIndex >= 0
        && request.resource.data.stageIndex < 24
        && request.resource.data.level in ['hint', 'reveal']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200
        && request.resource.data.actorPersonId == currentPersonId()
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/dayTaskGuides/$(studentToken)/items/$(request.resource.data.taskId))
        && get(/databases/$(database)/documents/dayTaskGuides/$(studentToken)/items/$(request.resource.data.taskId)).data.guide.presentation in ['math-route', 'learning-route']
        && request.resource.data.guideRevision == get(/databases/$(database)/documents/dayTaskGuides/$(studentToken)/items/$(request.resource.data.taskId)).data.guide.revision
        && request.resource.data.stageIndex < get(/databases/$(database)/documents/dayTaskGuides/$(studentToken)/items/$(request.resource.data.taskId)).data.guide.stages.size()
        && request.resource.data.stageId == get(/databases/$(database)/documents/dayTaskGuides/$(studentToken)/items/$(request.resource.data.taskId)).data.guide.stages[request.resource.data.stageIndex].id
        && request.resource.data.text == (request.resource.data.level == 'hint'
          ? get(/databases/$(database)/documents/dayTaskGuides/$(studentToken)/items/$(request.resource.data.taskId)).data.guide.stages[request.resource.data.stageIndex].hintPreview
          : get(/databases/$(database)/documents/dayTaskGuides/$(studentToken)/items/$(request.resource.data.taskId)).data.guide.stages[request.resource.data.stageIndex].revealPreview);
      allow update, delete: if false;
    }

    // A parent may close a task with a correct answer and incomplete reasoning.
    // The review remains unchanged; each choice is an immutable family event.
    // @see docs/modules/school-diary/day-page.md#parent-acceptance
    match /dayParentDecisions/{studentToken}/events/{eventId} {
      allow get, list: if dayUploadOwner(studentToken);
      allow create: if request.auth != null
        && request.resource.data.action in ['stage-required', 'stage-optional']
        && validReviewedStageChoice(studentToken, eventId, request.resource.data);
      allow create: if !(request.resource.data.action in ['stage-required', 'stage-optional'])
        && dayUploadOwner(studentToken)
        && parentMember(get(/databases/$(database)/documents/dayOwners/$(studentToken)).data.familyId)
        && eventId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.keys().hasOnly(['taskId', 'action', 'requirementId', 'variantId', 'stageId', 'stageIndex', 'guideRevision', 'reviewCheckedAt', 'actorPersonId', 'decidedAt'])
        && request.resource.data.keys().hasAll(['taskId', 'action', 'reviewCheckedAt', 'actorPersonId', 'decidedAt'])
        && request.resource.data.taskId is string
        && request.resource.data.taskId in get(/databases/$(database)/documents/dayPages/$(studentToken)).data.taskIds
        && request.resource.data.action in ['accept', 'reopen', 'require', 'optional', 'stage-required', 'stage-optional', 'variant-required', 'variant-optional']
        && request.resource.data.actorPersonId == currentPersonId()
        && request.resource.data.decidedAt == request.time
        && ((request.resource.data.action in ['variant-required', 'variant-optional']
            && request.resource.data.keys().hasOnly(['taskId', 'action', 'variantId', 'reviewCheckedAt', 'actorPersonId', 'decidedAt'])
            && request.resource.data.reviewCheckedAt == null
            && request.resource.data.variantId is string
            && request.resource.data.variantId.matches('^' + request.resource.data.taskId + '-v[1-9][0-9]*$')
            && get(/databases/$(database)/documents/dayPages/$(studentToken)).data.practiceVariantIds is list
            && request.resource.data.variantId in get(/databases/$(database)/documents/dayPages/$(studentToken)).data.practiceVariantIds)
          || (exists(/databases/$(database)/documents/dayProgress/$(studentToken)/items/$(request.resource.data.taskId))
            && !request.resource.data.keys().hasAny(['variantId'])
            && ((request.resource.data.action in ['accept', 'reopen']
            && !request.resource.data.keys().hasAny(['requirementId', 'stageId', 'stageIndex', 'guideRevision'])
            && get(/databases/$(database)/documents/dayProgress/$(studentToken)/items/$(request.resource.data.taskId)).data.status == 'partial'
            && get(/databases/$(database)/documents/dayProgress/$(studentToken)/items/$(request.resource.data.taskId)).data.assessmentBasis.outcome in ['met', 'not-met']
            && get(/databases/$(database)/documents/dayProgress/$(studentToken)/items/$(request.resource.data.taskId)).data.mathReasoning.answer == 'correct'
            && get(/databases/$(database)/documents/dayProgress/$(studentToken)/items/$(request.resource.data.taskId)).data.mathReasoning.argument in ['incomplete', 'not-shown', 'unreadable'])
          || (request.resource.data.action in ['require', 'optional']
            && request.resource.data.requirementId is string
            && !request.resource.data.keys().hasAny(['stageId', 'stageIndex', 'guideRevision'])
            && get(/databases/$(database)/documents/dayProgress/$(studentToken)/items/$(request.resource.data.taskId)).data.assessmentBasis.outcome == 'unresolved'
            && get(/databases/$(database)/documents/dayProgress/$(studentToken)/items/$(request.resource.data.taskId)).data.assessmentBasis.disputedRequirementIds is list
            && get(/databases/$(database)/documents/dayProgress/$(studentToken)/items/$(request.resource.data.taskId)).data.assessmentBasis.disputedRequirementIds.size() <= 10
            && request.resource.data.requirementId in get(/databases/$(database)/documents/dayProgress/$(studentToken)/items/$(request.resource.data.taskId)).data.assessmentBasis.disputedRequirementIds)
          )));
      allow update, delete: if false;
    }

    // A learner can send one current help request per task. No answer key or
    // tutor response is client writable. A request is not a mastery verdict.
    match /dayHelp/{studentToken}/items/{taskId} {
      allow get, list: if dayUploadOwner(studentToken);
      allow create, update: if dayUploadOwner(studentToken)
        && get(memberPath(get(/databases/$(database)/documents/dayOwners/$(studentToken)).data.familyId)).data.role == 'student'
        && exists(/databases/$(database)/documents/dayPages/$(studentToken))
        && taskId in get(/databases/$(database)/documents/dayPages/$(studentToken)).data.taskIds
        && request.resource.data.keys().hasOnly(['taskId', 'revision', 'requestedAt', 'requestKind', 'requestText'])
        && request.resource.data.keys().hasAll(['taskId', 'revision', 'requestedAt', 'requestKind', 'requestText'])
        && request.resource.data.taskId == taskId
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.revision <= 100000
        && request.resource.data.requestKind in ['condition', 'start', 'step', 'check']
        && request.resource.data.requestText is string
        && request.resource.data.requestText.size() <= 800
        && request.resource.data.requestedAt == request.time
        && (resource == null || (resource.data.taskId == taskId
          && request.resource.data.revision >= resource.data.revision));
      allow delete: if false;
    }

    match /dayUploads/{studentToken}/files/{uploadId} {
      allow get, list: if dayUploadOwner(studentToken);
      allow create: if dayUploadOwner(studentToken)
        && get(memberPath(get(/databases/$(database)/documents/dayOwners/$(studentToken)).data.familyId)).data.role == 'student'
        && uploadId.matches('^[A-Za-z0-9_-]{20,80}$')
        && get(/databases/$(database)/documents/dayPages/$(studentToken)).data.kind == 'student'
        && request.resource.data.keys().hasOnly(['taskId', 'planRevision', 'deviceUid', 'contentType', 'size', 'sha256', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['taskId', 'planRevision', 'deviceUid', 'contentType', 'size', 'sha256', 'status', 'createdAt'])
        && request.resource.data.taskId is string
        && request.resource.data.taskId in get(/databases/$(database)/documents/dayPages/$(studentToken)).data.taskIds
        && request.resource.data.planRevision == get(/databases/$(database)/documents/dayPages/$(studentToken)).data.planRevision
        && request.resource.data.deviceUid == request.auth.uid
        && request.resource.data.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif']
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 25000000
        && request.resource.data.sha256 is string
        && request.resource.data.sha256.matches('^[a-f0-9]{64}$')
        && request.resource.data.status == 'requested'
        && request.resource.data.createdAt == request.time;
      allow update: if dayUploadOwner(studentToken)
        && exists(/databases/$(database)/documents/dayPages/$(studentToken))
        && get(/databases/$(database)/documents/dayPages/$(studentToken)).data.kind == 'student'
        && (
          (resource.data.status == 'awaiting-upload'
            && resource.data.deviceUid == request.auth.uid
            && request.resource.data.status == 'uploaded'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          || (resource.data.status in ['requested', 'awaiting-upload', 'uploaded', 'upload-error', 'pending']
            && request.resource.data.status == 'deleted'
            && request.resource.data.deletedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedAt']))
        );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
