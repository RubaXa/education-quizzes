{
  "name": "education-quizzes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "bundle": "vite build",
    "build": "node scripts/build-site.mjs",
    "publish:pages": "node scripts/publish-pages.mjs",
    "push:publish": "node scripts/push-and-publish.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:bell-viewport": "node scripts/check-notification-viewport.mjs",
    "test:local-first": "vitest run src/lib/localFirstPilot.test.ts src/lib/materialPageCache.test.ts",
    "bench:reads": "vitest run src/components/ParentHome.readBudget.test.tsx src/lib/bookPageSource.test.ts src/lib/dayMaterialRefs.test.ts --reporter=verbose",
    "index:reads": "node scripts/firestore-read-index.mjs --write",
    "check:reads": "node scripts/firestore-read-index.mjs --self-test && node scripts/firestore-read-index.mjs",
    "check:spec": "node scripts/check-spec-map.mjs",
    "check": "npm run check:spec && npm run check:reads && npm run lint && npm run test && npm run build",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "quiz": "node scripts/quiz.mjs",
    "day": "node scripts/day.mjs",
    "storage": "node scripts/storage.mjs",
    "storage:worker": "node scripts/direct-upload-worker.mjs",
    "storage:install-worker": "node scripts/install-upload-worker.mjs",
    "archive:local": "node scripts/archive-local.mjs",
    "diary": "node diary/cli.mjs",
    "connect": "node scripts/connect.mjs",
    "family": "node scripts/family.mjs",
    "family:access": "node scripts/access-management.mjs",
    "family:audit": "node scripts/audit-family-links.mjs",
    "family:library": "node scripts/family-library.mjs",
    "sync:inbox": "node scripts/sync-inbox.mjs",
    "sync:project": "node scripts/sync-project.mjs",
    "sync:queue": "node scripts/sync-queue.mjs",
    "sync:books": "node scripts/sync-books.mjs",
    "books:manifests": "node scripts/backfill-book-manifests.mjs",
    "firestore:usage": "node scripts/firestore-usage.mjs",
    "submissions": "node scripts/submissions.mjs",
    "notifications": "node scripts/notifications.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.52.0",
    "mesh-diary": "github:voenniy/mesh-diary#319c44ff25a156dacd3afdf2773959db31ca29dc",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "jsdom": "^27.4.0",
    "lefthook": "^2.1.17",
    "oxlint": "^1.81.0",
    "shadcn": "^4.21.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
